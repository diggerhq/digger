                                },
                                "type": "array"
                            },
                            "on_pull_request_to_draft": {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "on_commit_to_default": {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "skip_merge_check": {
                                "type": "boolean"
                            }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                            "on_pull_request_pushed",
                            "on_pull_request_closed",
                            "on_pull_request_to_draft",
                            "on_commit_to_default",
                            "skip_merge_check"
                        ]
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "env_vars",
                    "workflow_configuration"
                ]
            },
            "type": "object"
        },
