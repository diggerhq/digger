                            }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                            "steps"
                        ]
                    },
                    "apply": {
                        "properties": {
                            "filter_regex": {
                                "type": "string"
                            },
                            "steps": {
                                "items": {
                                    "properties": {
                                        "Action": {
                                            "type": "string"
                                        },
                                        "Value": {
                                            "type": "string"
                                        },
                                        "extra_args": {
                                            "items": {
                                                "type": "string"
                                            },
                                            "type": "array"
                                        },
                                        "Shell": {
                                            "type": "string"
                                        }
                                    },
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                        "Action",
                                        "Value",
                                        "Shell"
                                    ]
                                },
                                "type": "array"
                            }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
