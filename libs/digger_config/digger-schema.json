{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://docs.opentaco.dev/schemas/digger.yml.json",
    "properties": {
        "apply_after_merge": {
            "type": "boolean",
            "description": "Automatically apply changes after PR is merged",
            "default": false
        },
        "respect_layers": {
            "type": "boolean",
            "description": "Respect layer ordering when executing projects",
            "default": false
        },
        "allow_draft_prs": {
            "type": "boolean",
            "description": "Allow Digger to run on draft pull requests",
            "default": false
        },
        "dependency_configuration": {
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": [
                        "hard",
                        "soft"
                    ],
                    "description": "Dependency resolution mode: 'hard' executes dependencies even if unchanged, 'soft' skips unchanged dependencies",
                    "default": "hard"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "mode"
            ]
        },
        "delete_prior_comments": {
            "type": "boolean",
            "description": "Delete previous Digger comments when posting new ones",
            "default": false
        },
        "disable_digger_apply_comment": {
            "type": "boolean",
            "description": "Disable the 'digger apply' comment command",
            "default": false
        },
        "disable_digger_apply_status_check": {
            "type": "boolean",
            "description": "Disable the apply status check on PRs",
            "default": false
        },
        "pr_locks": {
            "type": "boolean",
            "description": "Enable PR-level locking to prevent concurrent runs",
            "default": true
        },
        "projects": {
            "items": {
                "properties": {
                    "block_name": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "alias": {
                        "type": "string"
                    },
                    "apply_requirements": {
                        "items": {
                            "type": "string",
                            "enum": [
                                "approved",
                                "mergeable",
                                "undiverged"
                            ]
                        },
                        "type": "array",
                        "description": "Requirements that must be met before apply"
                    },
                    "dir": {
                        "type": "string"
                    },
                    "workspace": {
                        "type": "string"
                    },
                    "terragrunt": {
                        "type": "boolean"
                    },
                    "branch": {
                        "type": "string"
                    },
                    "opentofu": {
                        "type": "boolean"
                    },
                    "pulumi": {
                        "type": "boolean"
                    },
                    "workflow": {
                        "type": "string"
                    },
                    "workflow_file": {
                        "type": "string"
                    },
                    "include_patterns": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "layer": {
                        "type": "integer"
                    },
                    "exclude_patterns": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "depends_on": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "drift_detection": {
                        "type": "boolean"
                    },
                    "aws_role_to_assume": {
                        "properties": {
                            "aws_role_region": {
                                "type": "string"
                            },
                            "state": {
                                "type": "string"
                            },
                            "command": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                            "aws_role_region",
                            "state",
                            "command"
                        ]
                    },
                    "generated": {
                        "type": "boolean"
                    },
                    "aws_cognito_oidc": {
                        "properties": {
                            "aws_account_id": {
                                "type": "string"
                            },
                            "aws_region": {
                                "type": "string"
                            },
                            "cognito_identity_pool_id": {
                                "type": "string"
                            },
                            "session_duration": {
                                "type": "integer"
                            }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                            "aws_account_id",
                            "cognito_identity_pool_id",
                            "session_duration"
                        ]
                    },
                    "pulumi_stack": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "block_name",
                    "name",
                    "dir",
                    "workspace",
                    "terragrunt",
                    "opentofu",
                    "pulumi",
                    "workflow",
                    "workflow_file",
                    "layer",
                    "generated",
                    "pulumi_stack"
                ]
            },
            "type": "array"
        },
        "auto_merge": {
            "type": "boolean",
            "description": "Automatically merge PRs after successful apply",
            "default": false
        },
        "auto_merge_strategy": {
            "type": "string",
            "enum": [
                "squash",
                "merge",
                "rebase"
            ],
            "description": "Strategy to use when auto-merging PRs",
            "default": "squash"
        },
        "trusted_appIDs": {
            "items": {
                "type": "integer"
            },
            "type": "array"
        },
        "comment_render_mode": {
            "type": "string",
            "enum": [
                "basic",
                "group_by_module"
            ],
            "description": "How to render plan output in PR comments",
            "default": "basic"
        },
        "workflows": {
            "additionalProperties": {
                "properties": {
                    "env_vars": {
                        "properties": {
                            "state": {
                                "items": {
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "value_from": {
                                            "type": "string"
                                        },
                                        "value": {
                                            "type": "string"
                                        }
